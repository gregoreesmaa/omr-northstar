{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gregoreesmaa/omr-northstar/schemas/report.schema.json",
  "title": "OMR-NorthStar Evaluation Report",
  "description": "Canonical 4-layer report.json emitted by the OMR-NorthStar deterministic reference evaluator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_version",
    "split",
    "system_name",
    "layer1_headline",
    "layer2_matrix_and_deltas",
    "layer3_error_taxonomy",
    "layer4_forensic_pack"
  ],
  "$defs": {
    "matrix_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mean_q", "median_wfpp", "count"],
      "properties": {
        "mean_q": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "median_wfpp": { "type": ["number", "null"], "minimum": 0 },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "matrix_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CDR", "ALS", "RWP", "HWM"],
      "properties": {
        "CDR": { "$ref": "#/$defs/matrix_cell" },
        "ALS": { "$ref": "#/$defs/matrix_cell" },
        "RWP": { "$ref": "#/$defs/matrix_cell" },
        "HWM": { "$ref": "#/$defs/matrix_cell" }
      }
    },
    "page_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_id", "domain", "q_score", "wfpp", "catastrophic_failure"],
      "properties": {
        "page_id": { "type": "string", "minLength": 1 },
        "work_id": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "enum": ["CDR", "ALS", "RWP", "HWM"] },
        "tier": { "type": "string", "enum": ["T0", "T1", "T2", "T3", "T4", "T5"] },
        "q_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "wfpp": { "type": "number", "minimum": 0 },
        "ntsr": { "type": "number", "maximum": 1 },
        "catastrophic_failure": { "type": "boolean" },
        "cf_reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "benchmark_version": { "type": "string", "minLength": 1 },
    "split": {
      "anyOf": [
        { "type": "string", "enum": ["dev-v1", "test-v1", "fresh"] },
        { "type": "string", "pattern": "^fresh-[0-9]{4}$" }
      ]
    },
    "system_name": { "type": "string", "minLength": 1 },
    "layer1_headline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ns_score",
        "m_geom",
        "worst_stratum_q",
        "cfr_max",
        "stratum_scores",
        "stratum_cfr",
        "axes_macro",
        "human_utility"
      ],
      "properties": {
        "ns_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "tier_weighted_ns": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "ns_ci95": {
          "type": ["array", "null"],
          "items": { "type": "number", "minimum": 0, "maximum": 100 },
          "minItems": 2,
          "maxItems": 2
        },
        "m_geom": { "type": "number", "minimum": 0, "maximum": 100 },
        "worst_stratum_q": { "type": "number", "minimum": 0, "maximum": 100 },
        "cfr_max": { "type": "number", "minimum": 0, "maximum": 1 },
        "stratum_scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["CDR", "ALS", "RWP", "HWM"],
          "properties": {
            "CDR": { "type": "number", "minimum": 0, "maximum": 100 },
            "ALS": { "type": "number", "minimum": 0, "maximum": 100 },
            "RWP": { "type": "number", "minimum": 0, "maximum": 100 },
            "HWM": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "stratum_cfr": {
          "type": "object",
          "additionalProperties": false,
          "required": ["CDR", "ALS", "RWP", "HWM"],
          "properties": {
            "CDR": { "type": "number", "minimum": 0, "maximum": 1 },
            "ALS": { "type": "number", "minimum": 0, "maximum": 1 },
            "RWP": { "type": "number", "minimum": 0, "maximum": 1 },
            "HWM": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "axes_macro": {
          "type": "object",
          "additionalProperties": false,
          "required": ["s_note", "s_struct", "s_expr", "s_play"],
          "properties": {
            "s_note": { "type": "number", "minimum": 0, "maximum": 1 },
            "s_struct": { "type": "number", "minimum": 0, "maximum": 1 },
            "s_expr": { "type": "number", "minimum": 0, "maximum": 1 },
            "s_play": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "human_utility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["median_wfpp", "p90_wfpp", "p99_wfpp", "mean_ntsr", "nupr"],
          "properties": {
            "median_wfpp": { "type": "number", "minimum": 0 },
            "p90_wfpp": { "type": "number", "minimum": 0 },
            "p99_wfpp": { "type": "number", "minimum": 0 },
            "mean_ntsr": { "type": "number", "maximum": 1 },
            "nupr": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "layer2_matrix_and_deltas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier_domain_matrix", "paired_deltas"],
      "properties": {
        "tier_domain_matrix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["T0", "T1", "T2", "T3", "T4", "T5"],
          "properties": {
            "T0": { "$ref": "#/$defs/matrix_row" },
            "T1": { "$ref": "#/$defs/matrix_row" },
            "T2": { "$ref": "#/$defs/matrix_row" },
            "T3": { "$ref": "#/$defs/matrix_row" },
            "T4": { "$ref": "#/$defs/matrix_row" },
            "T5": { "$ref": "#/$defs/matrix_row" }
          },
          "description": "Map of tier (T0..T5) -> domain (CDR/ALS/RWP/HWM) -> {mean_q, median_wfpp, count}."
        },
        "paired_deltas": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "delta_engraver": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
            "delta_photo": { "type": ["number", "null"], "minimum": -100, "maximum": 100 },
            "delta_handwriting": { "type": ["number", "null"], "minimum": -100, "maximum": 100 }
          }
        },
        "adversarial_scorecard": {
          "type": "object",
          "properties": {
            "phr": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "ostinato_tsr": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "q4_q1_ratio": { "type": ["number", "null"], "minimum": 0 },
            "non_music_fp_count": { "type": ["integer", "null"], "minimum": 0 },
            "cross_page_spanner_f1": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "french_score_staff_acc": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
          }
        },
        "stress_tests": {
          "type": "object",
          "description": "Structured Pillar 1-3 adversarial stress-test suite results."
        }
      }
    },
    "layer3_error_taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout_segmentation_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "global_context_drift_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "pitch_accidental_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "rhythm_meter_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "polyphony_routing_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "engraving_expressive_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "hallucination_truncation_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "annotation_contamination_pct": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "layer4_forensic_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worst_pages", "best_pages"],
      "properties": {
        "worst_pages": {
          "type": "array",
          "items": { "$ref": "#/$defs/page_summary" }
        },
        "best_pages": {
          "type": "array",
          "items": { "$ref": "#/$defs/page_summary" }
        },
        "per_page_scores": {
          "type": "array",
          "items": { "$ref": "#/$defs/page_summary" },
          "description": "Optional full per-page score roster enabling paired permutation significance tests in compare(A, B)."
        },
        "efficiency_telemetry": {
          "type": "object",
          "properties": {
            "median_latency_s": { "type": ["number", "null"], "minimum": 0 },
            "p95_latency_s": { "type": ["number", "null"], "minimum": 0 },
            "peak_memory_gb": { "type": ["number", "null"], "minimum": 0 },
            "parameter_count": { "type": ["integer", "null"], "minimum": 0 }
          }
        }
      }
    },
    "nc_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n_pages", "nc_fp", "nmhr", "nc_pass", "ns_nc"],
      "properties": {
        "n_pages": { "type": "integer", "minimum": 0 },
        "nc_fp": { "type": "integer", "minimum": 0 },
        "nmhr": { "type": "number", "minimum": 0, "maximum": 1 },
        "nc_pass": { "type": "boolean" },
        "ns_nc": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "description": "Optional top-level Negative-Control Gate (NC-Gate) summary."
    },
    "stress_tests": {
      "type": "object",
      "description": "Optional top-level structured stress-test results (Pillar 1-3 gates and diagnostics)."
    },
    "per_page_scores": {
      "type": "array",
      "items": { "$ref": "#/$defs/page_summary" },
      "description": "Optional top-level per-page score roster for paired permutation significance testing."
    }
  }
}
